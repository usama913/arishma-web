@inherits LayoutComponentBase
<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">Arishma Lead Workspace</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Phase 0 scaffold</MudChip>
    </MudAppBar>
    <MudMainContent><MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">@Body</MudContainer></MudMainContent>
</MudLayout>
@code {
    private readonly MudTheme _theme = new() { PaletteLight = new PaletteLight { Primary = "#0A2342", Secondary = "#0A9A94", Tertiary = "#F59E0B", AppbarBackground = "#0A2342" } };
}
